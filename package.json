    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.6.0",
    "sass": "^1.93.0",
    "sharp": "^0.35.5",
    "vite": "^6.4.0",
    "vite-plugin-mkcert": "^1.17.12",
    "vitest": "^5.0.3"
  }
